DB_PASSWORD=77bd0d92b43d73ac
DB_NAME=roundcubemail

DELETE_LOCAL_ON_REMOTE_DELETE=0

SENT_FOLDER=INBOX.Sent
DRAFTS_FOLDER=INBOX.Drafts
TRASH_FOLDER=INBOX.Trash

SYNC_DRAFTS=1
DRAFT_OLD_VERSIONS=remove

# How quickly Start/Stop from the admin page is picked up (seconds)
ACCOUNT_RELOAD_INTERVAL=10

# How often push checks the LOCAL mirror for changes (cheap, local only)
PUSH_POLL_SECONDS=3
# Safety check of INBOX besides IDLE, and of other folders
INBOX_CHECK_SECONDS=30
OTHER_FOLDERS_SECONDS=60
FOLDER_DISCOVERY_SECONDS=600
# Only used if Hostinger lacks CONDSTORE: full flag rescan interval
FLAG_RESCAN_SECONDS=300

# --- Security -------------------------------------------------------
# Keep ON in production (Hostinger has a valid certificate)
REMOTE_TLS_VERIFY=1
# The only server(s) a Hostinger password is ever sent to (comma list)
REMOTE_ALLOWED_HOSTS=imap.hostinger.com
LOG_LEVEL=INFO

